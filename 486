  calibrate=!calibrate;
  $('#btnCal').classList.toggle('on',calibrate);
  toast(calibrate?'🎯 校准模式：拖动圆圈十字到正确位置（头部/眼睛/嘴巴/身体/头发）':'校准模式：关');
