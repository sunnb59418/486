let drag=null;
function pointInUV(x,y){
  const u=screenToUv(x,y),h=cfg.head;
  const dx=(u.x-h.x)/h.rx,dy=(u.y-h.y)/h.ry;
  return dx*dx+dy*dy<=1.4;
}
const pointInBody=(x,y)=>{const u=screenToUv(x,y);return u.x>0.02&&u.x<0.98&&u.y>0&&u.y<1;};
function bindStage(){
  const stage=$('#stage');
  stage.addEventListener('pointerdown',e=>{
    A.init();A.resume();
    const r=stage.getBoundingClientRect(),px=e.clientX-r.left,py=e.clientY-r.top;
    lastPointer.x=px;lastPointer.y=py;lastPointer.active=true;
    if(calibrate){
      const u=screenToUv(px,py);
      const cands=[{k:'head',x:cfg.head.x,y:cfg.head.y},{k:'eyes',x:cfg.eyes.x,y:cfg.eyes.y},
        {k:'mouth',x:cfg.mouth.x,y:cfg.mouth.y},{k:'breath',x:cfg.breath.x,y:cfg.breath.y},
        {k:'hair',x:cfg.hair.x,y:cfg.hair.y}];
      let best=null,bd=1e9;
      for(const c of cands){const d=Math.hypot((u.x-c.x)*S.aspect,u.y-c.y);if(d<bd){bd=d;best=c;}}
      if(bd<0.2){guideDrag=best.k;stage.setPointerCapture(e.pointerId);return;}
    }
    drag={x:px,y:py,sx:px,sy:py,t:performance.now(),moved:0,
      mode:pointInUV(px,py)?'head':'pan',ox:cfg.view.ox,oy:cfg.view.oy};
    stage.setPointerCapture(e.pointerId);
  });
  stage.addEventListener('pointermove',e=>{
    const r=stage.getBoundingClientRect(),px=e.clientX-r.left,py=e.clientY-r.top;
    lastPointer.x=px;lastPointer.y=py;lastPointer.active=true;
    dxLast=e.movementX||0;
    if(guideDrag){
      const u=screenToUv(px,py);
      const t={head:'head',eyes:'eyes',mouth:'mouth',breath:'breath',hair:'hair'}[guideDrag];
      cfg[t].x=u.x;cfg[t].y=u.y;syncPanel();return;
    }
    if(!drag)return;
    const dx=px-drag.x,dy=py-drag.y;
    if(drag.mode==='head'){
      D.yawT.t=clamp(D.yawT.t+dx*0.0075,-1.4,1.4);
      D.pitchT.t=clamp(D.pitchT.t+dy*0.006,-1.2,1.2);
      D.roll.t=clamp(D.roll.t+dx*0.005,-1.0,1.0);
    }else{
      cfg.view.ox=drag.ox+(px-drag.sx);cfg.view.oy=drag.oy+(py-drag.sy);
    }
    drag.x=px;drag.y=py;drag.moved=Math.hypot(px-drag.sx,py-drag.sy);
  });
  const up=e=>{
    if(guideDrag){guideDrag=null;saveCfg();return;}
    if(!drag)return;
    const dt=performance.now()-drag.t;
    if(dt<340&&drag.moved<12){
      const r=stage.getBoundingClientRect(),px=e.clientX-r.left,py=e.clientY-r.top;
      if(pointInUV(px,py))REACTIONS.pokeHead();
      else if(pointInBody(px,py))REACTIONS.pokeBody();
    }
    if(drag.mode==='head'&&Math.abs(dxLast)>2)D.hair.v+=dxLast*0.4;
    drag=null;
  };
  stage.addEventListener('pointerup',up);
  stage.addEventListener('pointercancel',up);
  stage.addEventListener('pointerleave',()=>{lastPointer.active=false;});
  stage.addEventListener('dblclick',e=>{
    const r=stage.getBoundingClientRect();
    if(pointInUV(e.clientX-r.left,e.clientY-r.top))REACTIONS.tsukkomi();
  });
  stage.addEventListener('wheel',e=>{
    e.preventDefault();
    cfg.view.zoom=clamp(cfg.view.zoom*(1-Math.sign(e.deltaY)*0.09),0.3,4);
    saveCfg();syncPanel();
  },{passive:false});
  window.addEventListener('keydown',e=>{
    A.init();A.resume();const k=e.key.toLowerCase();
    if(k==='1')REACTIONS.pat(); else if(k==='2')REACTIONS.pokeHead();
    else if(k==='3')REACTIONS.pokeBody(); else if(k==='4')REACTIONS.tsukkomi();
    else if(k==='5')REACTIONS.greet(); else if(k==='6')REACTIONS.confused();
    else if(k==='7')REACTIONS.shy(); else if(k==='8')REACTIONS.angry();
    else if(k==='b')triggerBlink();
    else if(k==='r'){cfg.view.zoom=1;cfg.view.ox=0;cfg.view.oy=0;syncPanel();}
    else if(k==='c')toggleCal();
    else if(k==='m')toggleDemo();
    else if(k==='g'){wiresOn=!wiresOn;toast(wiresOn?'网格线框：开':'网格线框：关');}
  });
  const dz=$('#drop');
  ['dragenter','dragover'].forEach(t=>window.addEventListener(t,e=>{e.preventDefault();
    dz.classList.remove('hide');dz.classList.add('over');}));
  ['dragleave','drop'].forEach(t=>window.addEventListener(t,e=>{e.preventDefault();dz.classList.remove('over');}));
  window.addEventListener('drop',e=>{const f=e.dataTransfer.files&&e.dataTransfer.files[0];if(f)loadFile(f);});
  window.addEventListener('paste',e=>{
    const it=e.clipboardData&&e.clipboardData.items;if(!it)return;
    for(const i of it) if(i.type.indexOf('image')===0){const f=i.getAsFile();if(f)loadFile(f);}
  });
}
function toast(m){const t=$('#toast');t.textContent=m;t.classList.add('show');
  clearTimeout(toast._t);toast._t=setTimeout(()=>t.classList.remove('show'),2200);}
