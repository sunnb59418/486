function loadFile(f){
  if(!f||f.type.indexOf('image')!==0){toast('请拖入图片文件');return;}
  const url=URL.createObjectURL(f),img=new Image();
  img.onload=()=>{
    S.img=img;
    cfg.crop.y0=0;
    cfg.crop.y1=(img.width/img.height<0.95)?0.42:1.0;
    buildTexture();autoAnchor();finishLoad();URL.revokeObjectURL(url);
  };
  img.onerror=()=>toast('图片读取失败');
  img.src=url;
}
function loadURL(u){const img=new Image();img.crossOrigin='anonymous';
  img.onload=()=>{S.img=img;cfg.crop.y1=(img.width/img.height<0.95)?0.42:1.0;buildTexture();autoAnchor();finishLoad();};
  img.onerror=()=>toast('加载失败（可能跨域）');img.src=u;}
function finishLoad(){
  S.ready=true;$('#drop').classList.add('hide');
  toast('已载入 '+S.texW+'×'+S.texH+' · 已自动估算锚点，请点「🎯 校准」微调');
  if(!calibrate) toggleCal();
  syncPanel();saveCfg();
}
async function autoLoad(){
  for(const n of ['subaru.png','subaru.jpg','subaru.webp','chara.png','model.png']){
    const ok=await new Promise(res=>{const i=new Image();i.onload=()=>res(true);i.onerror=()=>res(false);i.src=n;});
    if(ok){const img=new Image();img.onload=()=>{S.img=img;cfg.crop.y1=0.42;buildTexture();autoAnchor();finishLoad();};img.src=n;return;}
  }
}

