  tsec.appendChild(g3);
  const tip=document.createElement('p');tip.className='hint';
  tip.innerHTML=`快捷键：<b>1~8</b> 动作 · <b>B</b> 眨眼 · <b>C</b> 校准 · <b>M</b> 演示 · <b>G</b> 网格线框 · <b>R</b> 重置视图<br>
  鼠标：移动=视线跟随 · 拖头部=转头 · 拖空白=平移 · 滚轮=缩放 · 单击=反应 · 双击头=吐槽 · 长按头=摸头`;
  tsec.appendChild(tip);body.appendChild(tsec);
}
function syncPanel(){
  document.querySelectorAll('#panelBody [data-k]').forEach(el=>{
    const k=el.dataset.k,v=getVal(k,cfg);
    if(el.dataset.role==='range'){el.value=v;
      const i=el.closest('.row').querySelector('.lab i');if(i)i.textContent=(+v).toFixed(el.step<1?3:0);}
    else if(el.dataset.role==='color'){el.value=v;}
    else if(el.type==='checkbox'){el.checked=!!v;}
    else if(el.tagName==='SELECT'){el.value=v;}
  });
}
function bindSlot(k,file,el,label){
  const url=URL.createObjectURL(file);
  A.init();
  fetch(url).then(r=>r.arrayBuffer()).then(buf=>{
    A.ctx.decodeAudioData(buf,ab=>{
      A.buffers[k]=ab;slots[k]={name:file.name};
      el.classList.add('filled');el.textContent=(label||k)+' ✓ '+file.name.slice(0,10);
      toast('已绑定：'+file.name);
    },()=>toast('音频解码失败'));
  }).catch(()=>toast('音频读取失败'));
}
function shoot(){
  if(!S.ready){toast('还没有素材');return;}
  const cv=$('#gl'),cx=$('#fx'),out=document.createElement('canvas');
  out.width=cv.width;out.height=cv.height;
  const c=out.getContext('2d');c.fillStyle='#0a0e18';c.fillRect(0,0,out.width,out.height);
  c.drawImage(cv,0,0);c.drawImage(cx,0,0);
  const a=document.createElement('a');a.download='subaru-'+Date.now()+'.png';a.href=out.toDataURL('image/png');a.click();
  toast('已保存截图');
}

/* =======================================================================
 * 11. 启动
 * ======================================================================= */
function boot(){
  loadCfg();
  if(!initGL())return;
  initFX();buildPanel();bindStage();
  $('#btnPanel').addEventListener('click',()=>{$('#panel').classList.toggle('open');syncPanel();
    setTimeout(()=>{},320);});
  $('#btnPanelClose').addEventListener('click',()=>$('#panel').classList.remove('open'));
  $('#btnFile').addEventListener('click',()=>$('#file').click());
  $('#file').addEventListener('change',e=>{if(e.target.files[0])loadFile(e.target.files[0]);});
  $('#urlinput').addEventListener('keydown',e=>{if(e.key==='Enter'&&e.target.value.trim())loadURL(e.target.value.trim());});
  $('#btnShoot').addEventListener('click',shoot);
  $('#btnBlink').addEventListener('click',()=>triggerBlink());
  $('#btnCal').addEventListener('click',toggleCal);
  $('#btnDemo').addEventListener('click',toggleDemo);
  document.querySelectorAll('#dock [data-act]').forEach(b=>
    b.addEventListener('click',()=>{A.init();A.resume();REACTIONS[b.dataset.act]();}));
  $('#btnHelp').addEventListener('click',()=>alert(
    '菜月昴 · 互动角色 v2\n\n'+
    '【三步上手】\n'+
    '1. 导入图片（拖入/选择/Ctrl+V）\n'+
    '2. 点「🎯 校准」，把画面上 5 个圆圈十字拖到：头部中心 / 双眼中心 / 嘴巴 / 身体中心 / 头发中心\n'+
    '3. 点「▶ 演示」，先看每项变形是否生效\n\n'+
    '【觉得动得不够】面板 → ★ 变形强度，把「头部转动强度」拉到 2 左右\n'+
    '【闭眼出现色块】面板 → ③ 眼睛叠加，闭眼绘制方式改为「只画睫毛线」\n'+
    '【看不清哪里在动】面板 → 显示网格线框（或按 G）\n\n'+
    '快捷键：1~8 动作，B 眨眼，C 校准，M 演示，G 线框，R 重置视图'
  ));
  computeView();
  window.addEventListener('resize',computeView);
  requestAnimationFrame(frame);
  autoLoad();
}
boot();
</script>
