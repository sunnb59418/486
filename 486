let fx=null,fxc=null;
function initFX(){fx=$('#fx');fxc=fx.getContext('2d');}
function drawFX(dt,P,st){
  const dpr=Math.min(window.devicePixelRatio||1,2);
  const W=Math.round(fx.clientWidth*dpr),H=Math.round(fx.clientHeight*dpr);
  if(fx.width!==W||fx.height!==H){fx.width=W;fx.height=H;}
  fxc.setTransform(dpr,0,0,dpr,0,0);
  fxc.clearRect(0,0,fx.clientWidth,fx.clientHeight);
  if(!S.ready)return;
