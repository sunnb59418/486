  cfg.mouth={x:b.cx, y:hy+hry*0.62, w:hrx*0.24, h:hry*0.10};
  cfg.breath={x:b.x0+b.w*0.5, y:hy+hry*2.1, rx:Math.max(0.2,b.w*0.42), ry:0.42};
