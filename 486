  gl.uniform1f(U.u_roll,P.roll);      gl.uniform1f(U.u_breath,P.breath);
  gl.uniform1f(U.u_swayX,P.swayX);    gl.uniform1f(U.u_swayY,P.swayY);
  gl.uniform1f(U.u_hairSway,P.hair);  gl.uniform1f(U.u_blink,P.blink);
  gl.uniform1f(U.u_mouthOpen,P.mouthOpen);
  gl.uniform1f(U.u_squash,P.squash);  gl.uniform1f(U.u_shakeX,P.shakeX);
  gl.uniform1f(U.u_shakeY,P.shakeY);  gl.uniform1f(U.u_alpha,S.ready?1:0);
  gl.uniform1f(U.u_ampH,cfg.amp.head);gl.uniform1f(U.u_ampB,cfg.amp.breath);
  gl.uniform1f(U.u_ampE,cfg.amp.eye); gl.uniform1f(U.u_ampM,cfg.amp.mouth);
