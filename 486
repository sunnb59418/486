  for(let i=0;i<=M;i++){fxc.beginPath();
    for(let j=0;j<=N;j++){const p=pt(i,j);j?fxc.lineTo(p.x,p.y):fxc.moveTo(p.x,p.y);}fxc.stroke();}
  for(let j=0;j<=N;j++){fxc.beginPath();
    for(let i=0;i<=M;i++){const p=pt(i,j);i?fxc.lineTo(p.x,p.y):fxc.moveTo(p.x,p.y);}fxc.stroke();}
