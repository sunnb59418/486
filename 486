  const headH=hH*0.30;                             // 上半身裁切里头部约占可见高度 30%
  const hy=hTop+headH*0.48;
  const hry=headH*0.52;
  const hrx=hry/ar*1.05;
  cfg.head={x:b.cx, y:hy, rx:hrx, ry:hry};
