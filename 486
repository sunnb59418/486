function rgbStr(c,a){return `rgba(${c[0]|0},${c[1]|0},${c[2]|0},${a})`;}
function drawEyes(P,us){
  const ov=cfg.overlay;
  const closed=P.blink;
  const happy=arguments[2]&&arguments[2].eyeStyle==='happy';
  if(!happy&&closed<0.05)return;
  let style=ov.lidStyle;
  if(style==='off')return;
  if(style==='auto') style = (S.skinCol[0]>168 ? 'skin' : 'line');
  const a = happy?1:clamp(closed*1.7-0.12,0,1);
  const skin = ov.skinAuto?S.skinCol:hex2rgb(ov.skin);
  const e=cfg.eyes;
  for(const cu of eyeCentersUV()){
    const c=uvToScreen(cu.x,cu.y);
    const rx=Math.max(6,e.w*1.45*us.x), ry=Math.max(4,e.h*1.6*us.y);
    if(style==='skin'||happy){
      fxc.save();fxc.globalAlpha=a;
      const g=fxc.createRadialGradient(c.x,c.y,0,c.x,c.y,rx);
      g.addColorStop(0,rgbStr(skin,1));g.addColorStop(0.66,rgbStr(skin,0.97));g.addColorStop(1,rgbStr(skin,0));
      fxc.fillStyle=g;fxc.beginPath();fxc.ellipse(c.x,c.y,rx,ry,0,0,6.2832);fxc.fill();
      fxc.restore();
    }
    fxc.save();fxc.globalAlpha=a;
    fxc.strokeStyle=style==='line'?rgbStr(shade(skin,0.22),1):ov.lash;
    fxc.lineWidth=Math.max(1.8,ry*0.55);fxc.lineCap='round';
