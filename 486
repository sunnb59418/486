    fxc.beginPath();
    fxc.moveTo(c.x-rx*0.82, c.y+(happy?ry*0.28:0));
    fxc.quadraticCurveTo(c.x, c.y-lift, c.x+rx*0.82, c.y+(happy?ry*0.28:0));
    fxc.stroke();fxc.restore();
  }
}
