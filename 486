function updateParticles(dt){
  if(particles.length<34&&Math.random()<0.35)
    particles.push({x:rand(0,1),y:1.06,s:rand(1,3.2),v:rand(0.016,0.05),a:rand(0.1,0.3),ph:rand(0,6.28)});
  for(let i=particles.length-1;i>=0;i--){const p=particles[i];p.y-=p.v*dt;
    p.x+=Math.sin(clock*0.7+p.ph)*0.00022; if(p.y<-0.06)particles.splice(i,1);}
