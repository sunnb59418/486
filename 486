let lastT=performance.now(),fpsAcc=0,fpsN=0;
function frame(now){
  requestAnimationFrame(frame);
  let dt=(now-lastT)/1000;lastT=now;dt=Math.min(dt,0.05);clock+=dt;

  /* ---- 演示模式 ---- */
  let demoP=null;
  if(demo.on){
    demo.t+=dt;
    const i=Math.floor(demo.t/2.4)%DEMO_STEPS.length, lt=demo.t%2.4;
    if(i!==demo.idx){demo.idx=i;const l=$('#demoLabel');l.textContent=DEMO_STEPS[i];l.classList.add('show');}
    demoP={idx:i,t:lt};
  } else if(demo.idx!==-1){demo.idx=-1;$('#demoLabel').classList.remove('show');}

  /* ---- 目标值 ---- */
  if(demoP){
    const p=demoP;
    D.yawT.t   = p.idx===0?Math.sin(p.t*2.4)*1.15:0;
    D.pitchT.t = p.idx===1?Math.sin(p.t*2.4)*0.8:0;
    D.roll.t   = p.idx===1?Math.sin(p.t*1.3)*0.55:0;
    D.breath.t = p.idx===3?Math.sin(p.t*2.2)*1.6:Math.sin(clock*1.35);
    D.hair.t   = p.idx===5?Math.sin(p.t*4.2)*1.5:0;
    if(p.idx===4) mouthScript.on=true,mouthScript.v=Math.abs(Math.sin(p.t*5.5))*0.95;
    if(p.idx===6){ if(p.t<0.06)squashImpulse(-3.5); if(p.t>1.2&&p.t<1.26)squashImpulse(2.5); }
  } else {
    D.breath.t=Math.sin(clock*1.35);
    if(lastPointer.active&&S.ready){
      const u=screenToUv(lastPointer.x,lastPointer.y),h=cfg.head;
      D.yawT.t  =clamp((u.x-h.x)/(h.rx*1.5),-1,1)*0.95*cfg.follow.headX;
      D.pitchT.t=clamp((u.y-h.y)/(h.ry*1.8),-1,1)*0.65*cfg.follow.headY;
    } else {
      D.yawT.t=Math.sin(clock*0.41)*0.30;
      D.pitchT.t=Math.sin(clock*0.29)*0.16;
    }
  }
  D.swayX.t=demoP?0:Math.sin(clock*0.62)*0.0045+Math.sin(clock*1.9)*0.0015;
  D.swayY.t=demoP?0:Math.sin(clock*0.83)*0.0028;

  const bl  = (demoP&&demoP.idx===2) ? (Math.sin(demoP.t*3.2*Math.PI)*0.5+0.5) : blinkValue(dt);
  if(!demoP && Math.random()<0.0009) triggerBlink();
  if(!demoP && !guideDrag){
    D.yawK.t=lerp(D.yawK.t,0,1-Math.exp(-2.4*dt));
    D.pitchK.t=lerp(D.pitchK.t,0,1-Math.exp(-2.4*dt));
    D.roll.t=lerp(D.roll.t,0,1-Math.exp(-2.0*dt));
    D.shakeX.t=lerp(D.shakeX.t,0,1-Math.exp(-3*dt));
    D.shakeY.t=lerp(D.shakeY.t,0,1-Math.exp(-3*dt));
  }
  ['yawT','yawK','pitchT','pitchK','roll','breath','swayX','swayY','hair','squash','shakeX','shakeY']
    .forEach(k=>stepS(D[k], k==='squash'?150:120, k==='squash'?17:13, dt));

  const yaw=D.yawT.x+D.yawK.x;
  D.hair.t = D.hair.t*0.55 + (-yaw*0.9-(D.yawT.v+D.yawK.v)*0.5)*0.45;

  /* ---- 口型 ---- */
  let mouthOpen=0;
  if(cfg.audio.lip&&S.playing) mouthOpen=A.lip(dt);
  else if(mouthScript.on){
    mouthScript.t+=dt;
    if(mouthScript.t>=mouthScript.until){mouthScript.on=false;mouthScript.v=0;}
    else mouthScript.v=lerp(mouthScript.v,(Math.sin(clock*17)*0.5+0.5)*rand(0.4,1),1-Math.exp(-16*dt));
    mouthOpen=mouthScript.v;
  } else mouthOpen=lerp(mouthOpen,0,1-Math.exp(-9*dt));

  let eyeStyle='open';
  if(mode==='happy') eyeStyle='happy';
  if(mode==='shy') addBlush(0.35);
  blushT-=dt; if(blushT<=0) blush=lerp(blush,0,1-Math.exp(-1.6*dt));

  const P={yaw,pitch:D.pitchT.x+D.pitchK.x,roll:D.roll.x,breath:D.breath.x,
    swayX:D.swayX.x,swayY:D.swayY.x,hair:D.hair.x,blink:eyeStyle==='happy'?0:clamp(bl,0,1),
    mouthOpen,squash:clamp(D.squash.x,-1.4,1.4),shakeX:D.shakeX.x,shakeY:D.shakeY.x};

  renderGL(P);
  drawFX(dt,P,{eyeStyle});

  if(!demoP&&S.ready){
    idleTimer-=dt;
    if(idleTimer<=0){idleTimer=rand(12,24);
      if(Math.random()<0.5)say(pick(lines.idle)); else triggerBlink();}
  }
  if(!demoP){ patHover = (lastPointer.active&&patCool<=0)?patHover+dt:0; patCool-=dt;
    if(patHover>0.5){patHover=0;patCool=3.2;REACTIONS.pat();} }

  fpsAcc+=dt;fpsN++;
  if(fpsAcc>0.5){const f=(fpsN/fpsAcc).toFixed(0);
    if(!S.glInfo)showGL(f+' FPS');fpsAcc=0;fpsN=0;}
}
function renderGL(P){
