function keyBackground(id,mode,tol){
  const w=id.width,h=id.height,data=id.data,N=w*h;
  const bg=new Uint8Array(N),q=new Int32Array(N);let qh=0,qt=0;
  const cand=i=>{const p=i<<2;const lum=(data[p]*299+data[p+1]*587+data[p+2]*114)/1000;
    return mode==='light'?lum>(255-tol):lum<tol;};
  const push=(x,y)=>{if(x<0||y<0||x>=w||y>=h)return;const i=y*w+x;if(bg[i]||!cand(i))return;bg[i]=1;q[qt++]=i;};
  for(let x=0;x<w;x++){push(x,0);push(x,h-1);}
  for(let y=0;y<h;y++){push(0,y);push(w-1,y);}
  while(qh<qt){const i=q[qh++],x=i%w,y=(i/w)|0;push(x-1,y);push(x+1,y);push(x,y-1);push(x,y+1);}
  for(let i=0;i<N;i++) if(bg[i]) data[(i<<2)+3]=0;
}
function blurAlpha(id,radius){
  const w=id.width,h=id.height,d=id.data,r0=Math.max(1,radius|0);
  const tmp=new Float32Array(w*h);for(let i=0;i<w*h;i++)tmp[i]=d[(i<<2)+3];
  const out=new Float32Array(w*h),win=r0*2+1;
  for(let y=0;y<h;y++){const b=y*w;let s=0;
    for(let x=-r0;x<=r0;x++)s+=tmp[b+clamp(x,0,w-1)];
    for(let x=0;x<w;x++){out[b+x]=s/win;s+=tmp[b+clamp(x+r0+1,0,w-1)]-tmp[b+clamp(x-r0,0,w-1)];}}
  for(let x=0;x<w;x++){let s=0;
    for(let y=-r0;y<=r0;y++)s+=out[clamp(y,0,h-1)*w+x];
    for(let y=0;y<h;y++){d[((y*w+x)<<2)+3]=s/win;s+=out[clamp(y+r0+1,0,h-1)*w+x]-out[clamp(y-r0,0,h-1)*w+x];}}
