function premultiply(id){
  const d=id.data;
  for(let i=0;i<d.length;i+=4){const a=d[i+3];if(a===255)continue;const f=a/255;
    d[i]*=f;d[i+1]*=f;d[i+2]*=f;}
}
/* α 包围盒 + 顶部 28% 区域横向质心 */
function alphaStats(id,dw,dh,pad){
  let x0=1e9,y0=1e9,x1=-1,y1=-1;
  const band=[]; let cxSum=0,cxN=0;
  for(let y=0;y<dh;y+=2){
    for(let x=0;x<dw;x+=2){
      const a=id.data[((y+pad)*id.width+(x+pad))*4+3];
      if(a>60){ if(x<x0)x0=x; if(x>x1)x1=x; if(y<y0)y0=y; if(y>y1)y1=y; band.push([x,y]); }
    }
  }
  if(x1<0) return {x0:0,y0:0,x1:1,y1:1,w:1,h:1,cx:0.5};
  const cut=y0+(y1-y0)*0.30;
  for(const [x,y] of band) if(y<=cut){cxSum+=x;cxN++;}
  return {x0:x0/dw,y0:y0/dh,x1:x1/dw,y1:y1/dh,w:(x1-x0)/dw,h:(y1-y0)/dh,
          cx:(cxN?cxSum/cxN:((x0+x1)/2))/dw};
}
/* 皮肤取样：只取脸颊/额头，且必须“够亮”，避免取到头发 */
function sampleSkin(id,dw,dh,pad){
  const w=id.width,d=id.data;
  const e=cfg.eyes,m=cfg.mouth;
  const pts=[
    [e.x-e.dx*1.45, e.y+(m.y-e.y)*0.42],
    [e.x+e.dx*1.45, e.y+(m.y-e.y)*0.42],
    [e.x,           e.y+(m.y-e.y)*0.72],
    [e.x,           e.y-e.h*2.4],
    [e.x-e.dx*0.45, e.y+e.h*1.6]
  ];
  const cand=[];
  for(const [ux,uy] of pts){
    const x=clamp(Math.round(pad+ux*dw),0,w-1), y=clamp(Math.round(pad+uy*dh),0,id.height-1);
    const i=(y*w+x)*4,a=d[i+3];
    if(a>40){
      const r=d[i]/a*255,g=d[i+1]/a*255,b=d[i+2]/a*255;
      const lum=(r*299+g*587+b*114)/1000;
      if(lum>110 && (r-b)>-40) cand.push([r,g,b,lum]);
    }
  }
  if(!cand.length){ S.skinCol=[242,211,184]; return; }
  cand.sort((p,q)=>q[3]-p[3]);                    // 取最亮的
  const s=cand[0]; S.skinCol=[s[0],s[1],s[2]];
}
function autoAnchor(){
  const b=S.bbox; if(!b||!S.texW) return;
