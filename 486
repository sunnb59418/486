  gl.uniform2f(U.u_breathC,b.x,b.y);  gl.uniform2f(U.u_breathR,b.rx,b.ry);
  gl.uniform2f(U.u_hairC,hr.x,hr.y);  gl.uniform2f(U.u_hairR,hr.rx,hr.ry);
