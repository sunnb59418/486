const eyeCentersUV=()=>[{x:cfg.eyes.x-cfg.eyes.dx,y:cfg.eyes.y},{x:cfg.eyes.x+cfg.eyes.dx,y:cfg.eyes.y}];
function drawBlush(us){
  if(blush<0.02)return;
  const e=cfg.eyes,m=cfg.mouth,y=e.y+(m.y-e.y)*0.46;
  for(const s of [-1,1]){
    const c=uvToScreen(e.x+s*e.dx*1.05,y),rx=e.w*1.6*us.x,ry=e.h*1.4*us.y;
    const g=fxc.createRadialGradient(c.x,c.y,0,c.x,c.y,Math.max(rx,ry));
    g.addColorStop(0,`rgba(255,120,150,${0.45*blush})`);
    g.addColorStop(0.55,`rgba(255,110,145,${0.25*blush})`);
    g.addColorStop(1,'rgba(255,110,145,0)');
    fxc.fillStyle=g;fxc.save();fxc.translate(c.x,c.y);fxc.scale(1,ry/Math.max(rx,1e-3)*1.2);
    fxc.beginPath();fxc.arc(0,0,rx,0,6.2832);fxc.fill();fxc.restore();
