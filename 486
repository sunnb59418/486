<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"/>
<title>菜月昴 · 互动角色 v2（Live2D 式网格变形）</title>
<style>
:root{--txt:#e9eef8;--acc:#7fe3c4;--acc2:#ffd166;--panel:rgba(12,16,28,.88);--line:rgba(255,255,255,.12)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;margin:0;background:#05060a;color:var(--txt);overflow:hidden;user-select:none;
  font-family:"Noto Sans SC","PingFang SC","Hiragino Sans GB","Microsoft YaHei",system-ui,sans-serif}
#stage{position:fixed;inset:0;touch-action:none;cursor:crosshair}
#bg{position:absolute;inset:0;background:radial-gradient(1200px 760px at 50% 8%,#26325c 0%,#141b30 42%,#06070d 100%)}
#bggrid{position:absolute;inset:0;opacity:.13;
  background-image:linear-gradient(rgba(127,227,196,.5) 1px,transparent 1px),linear-gradient(90deg,rgba(127,227,196,.5) 1px,transparent 1px);
  background-size:46px 46px;
  -webkit-mask-image:radial-gradient(circle at 50% 46%,#000 0%,transparent 70%);
  mask-image:radial-gradient(circle at 50% 46%,#000 0%,transparent 70%)}
#vig{position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at 50% 45%,transparent 42%,rgba(0,0,0,.72) 100%)}
canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
#fx{pointer-events:none}
#hud{position:absolute;top:0;left:0;right:0;padding:12px 16px;display:flex;justify-content:space-between;align-items:center;pointer-events:none}
.brand{display:flex;align-items:center;gap:10px;pointer-events:auto}
.brand b{font-size:15px;letter-spacing:.06em}
.brand small{display:block;font-size:11px;opacity:.55}
.dot{width:9px;height:9px;border-radius:50%;background:var(--acc);box-shadow:0 0 12px var(--acc)}
.hudbtns{display:flex;gap:8px;pointer-events:auto}
.btn{background:rgba(255,255,255,.06);border:1px solid var(--line);color:var(--txt);padding:8px 13px;
  border-radius:10px;font-size:13px;cursor:pointer;transition:.15s;backdrop-filter:blur(8px);font-family:inherit}
.btn:hover{background:rgba(127,227,196,.16);border-color:rgba(127,227,196,.5)}
.btn:active{transform:translateY(1px)}
.btn.on{background:rgba(255,209,102,.2);border-color:rgba(255,209,102,.6);color:#ffe9b0}
.btn.pri{background:linear-gradient(180deg,rgba(127,227,196,.3),rgba(127,227,196,.13));border-color:rgba(127,227,196,.6);color:#c6fff0;font-weight:600}
#dock{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);display:flex;gap:7px;flex-wrap:wrap;
  justify-content:center;max-width:min(97vw,1080px);padding:9px 11px;border-radius:16px;background:var(--panel);
  border:1px solid var(--line);backdrop-filter:blur(14px);box-shadow:0 12px 40px rgba(0,0,0,.5);z-index:6}
#bubble{position:absolute;left:0;top:0;max-width:min(74vw,420px);padding:11px 15px;border-radius:14px;
  background:linear-gradient(180deg,rgba(24,30,48,.96),rgba(14,18,30,.96));border:1px solid rgba(127,227,196,.35);
  box-shadow:0 10px 34px rgba(0,0,0,.55);font-size:14.5px;line-height:1.5;opacity:0;transition:opacity .18s;
  pointer-events:none;z-index:5}
#bubble.show{opacity:1}
#demoLabel{position:absolute;left:50%;top:64px;transform:translateX(-50%);font-size:15px;letter-spacing:.16em;
  padding:7px 18px;border-radius:20px;background:rgba(127,227,196,.14);border:1px solid rgba(127,227,196,.5);
  color:#c6fff0;opacity:0;transition:.2s;pointer-events:none;z-index:7;white-space:nowrap}
#demoLabel.show{opacity:1}
#panel{position:absolute;top:0;right:0;bottom:0;width:min(94vw,400px);background:var(--panel);border-left:1px solid var(--line);
  backdrop-filter:blur(16px);transform:translateX(102%);transition:transform .3s cubic-bezier(.3,.9,.3,1);
  display:flex;flex-direction:column;z-index:20}
#panel.open{transform:none}
#panel header{padding:14px 16px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}
#panel header b{font-size:14px;letter-spacing:.05em}
#panelBody{flex:1;overflow:auto;padding:6px 14px 30px;scrollbar-width:thin}
#panelBody::-webkit-scrollbar{width:8px}
#panelBody::-webkit-scrollbar-thumb{background:rgba(255,255,255,.16);border-radius:4px}
.sec{margin:14px 0 6px;padding-top:10px;border-top:1px dashed rgba(255,255,255,.09)}
.sec:first-child{border-top:0}
.sec>h4{margin:0 0 9px;font-size:12.5px;letter-spacing:.09em;color:var(--acc);font-weight:600}
.row{margin-bottom:9px}
.row .lab{display:flex;justify-content:space-between;font-size:11.5px;opacity:.8;margin-bottom:5px}
.row .lab i{font-style:normal;color:var(--acc2);font-variant-numeric:tabular-nums}
input[type=range]{width:100%;height:20px;-webkit-appearance:none;background:transparent;cursor:pointer}
input[type=range]::-webkit-slider-runnable-track{height:4px;border-radius:3px;background:rgba(255,255,255,.16)}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;margin-top:-5px;border-radius:50%;background:var(--acc);box-shadow:0 0 8px rgba(127,227,196,.7)}
input[type=range]::-moz-range-track{height:4px;border-radius:3px;background:rgba(255,255,255,.16)}
input[type=range]::-moz-range-thumb{width:14px;height:14px;border:0;border-radius:50%;background:var(--acc)}
.chk{display:flex;align-items:center;gap:9px;font-size:12.5px;opacity:.9;margin:8px 0;cursor:pointer}
.chk input{width:16px;height:16px;accent-color:var(--acc)}
textarea{width:100%;min-height:110px;background:rgba(0,0,0,.35);border:1px solid var(--line);border-radius:10px;
  color:var(--txt);padding:9px;font-size:12.5px;line-height:1.55;resize:vertical;font-family:inherit}
.slots{display:flex;flex-wrap:wrap;gap:7px;margin-top:8px}
.slot{padding:7px 11px;border-radius:9px;font-size:11.5px;cursor:pointer;border:1px dashed rgba(255,255,255,.25);
  background:rgba(255,255,255,.04);transition:.15s}
.slot:hover{border-color:var(--acc);background:rgba(127,227,196,.1)}
.slot.filled{border-style:solid;border-color:rgba(255,209,102,.6);background:rgba(255,209,102,.12);color:#ffe9b0}
.slot.over{border-color:var(--acc);background:rgba(127,227,196,.25)}
.hint{font-size:11.5px;line-height:1.65;opacity:.62;margin:8px 0 0}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
#drop{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;z-index:15;
  background:radial-gradient(circle at 50% 45%,rgba(10,14,24,.72),rgba(5,6,10,.94))}
#drop.hide{display:none}
.card{width:min(92vw,520px);padding:28px 26px;border-radius:20px;text-align:center;
  background:linear-gradient(180deg,rgba(24,30,50,.94),rgba(12,16,26,.96));border:1px solid rgba(127,227,196,.3);
  box-shadow:0 24px 70px rgba(0,0,0,.7)}
.card h2{margin:0 0 8px;font-size:19px}
.card p{margin:0 0 18px;font-size:12.5px;line-height:1.75;opacity:.7}
.card .big{font-size:38px;margin-bottom:6px}
#drop.over .card{border-color:var(--acc);background:rgba(127,227,196,.12)}
.urlinput{width:100%;margin-top:10px;padding:9px 11px;border-radius:9px;font-size:12px;background:rgba(0,0,0,.4);
  border:1px solid var(--line);color:var(--txt);font-family:inherit}
#toast{position:absolute;left:50%;top:110px;transform:translate(-50%,-14px);opacity:0;padding:9px 16px;border-radius:10px;
  background:rgba(10,14,24,.94);border:1px solid var(--line);font-size:12.5px;transition:.25s;pointer-events:none;z-index:40}
#toast.show{opacity:1;transform:translate(-50%,0)}
#glstat{position:absolute;left:12px;bottom:12px;font-size:10.5px;opacity:.4;font-variant-numeric:tabular-nums;z-index:8;pointer-events:none}
@media(max-width:660px){#dock{bottom:8px;gap:5px;padding:7px}#dock .btn{padding:7px 9px;font-size:11.5px}#glstat{display:none}}
</style>
</head>
<body>
<div id="stage">
  <div id="bg"></div><div id="bggrid"></div>
  <canvas id="gl"></canvas>
  <canvas id="fx"></canvas>
  <div id="vig"></div>

  <header id="hud">
    <div class="brand"><div class="dot"></div>
      <div><b>菜月昴</b><small>NATSUKI SUBARU · v2 网格变形引擎</small></div>
    </div>
    <div class="hudbtns">
      <button class="btn" id="btnDemo">▶ 演示</button>
      <button class="btn" id="btnCal">🎯 校准</button>
      <button class="btn" id="btnHelp">帮助</button>
      <button class="btn" id="btnPanel">面板</button>
    </div>
  </header>

  <div id="bubble"><span id="bubbleText"></span></div>
  <div id="demoLabel"></div>
  <div id="glstat"></div>

  <div id="dock">
    <button class="btn" data-act="pat">🖐 摸头</button>
    <button class="btn" data-act="pokeHead">👆 戳头</button>
    <button class="btn" data-act="pokeBody">👉 戳身</button>
    <button class="btn" data-act="tsukkomi">💢 吐槽</button>
    <button class="btn" data-act="greet">🙋 打招呼</button>
    <button class="btn" data-act="confused">❓ 困惑</button>
    <button class="btn" data-act="shy">😳 害羞</button>
    <button class="btn" data-act="angry">🔥 生气</button>
    <button class="btn" id="btnBlink">👁 眨眼</button>
    <button class="btn" id="btnShoot">📷 截图</button>
  </div>

  <aside id="panel">
    <header><b>调参面板</b><button class="btn" id="btnPanelClose">关闭</button></header>
    <div id="panelBody"></div>
  </aside>

  <div id="drop">
    <div class="card">
      <div class="big">🗡️</div>
      <h2>导入菜月昴立绘</h2>
      <p>拖入图片 / 点击选择 / Ctrl+V 粘贴。<br>
         黑底或白底整身立绘都可以：引擎会自动抠底并裁出上半身。<br>
         <b>导入后请点右上角「🎯 校准」</b>，把三个圆圈拖到正确位置即可。</p>
      <button class="btn pri" id="btnFile">选择图片文件</button>
      <input type="file" id="file" accept="image/*" hidden>
      <input class="urlinput" id="urlinput" placeholder="或粘贴图片 URL 后回车">
      <p class="hint">同目录放 <b>subaru.png</b> 可自动加载。</p>
    </div>
  </div>
  <div id="toast"></div>
</div>

<script>
"use strict";
/* =======================================================================
 * 0. 工具
 * ======================================================================= */
const $ = s=>document.querySelector(s);
const clamp=(v,a,b)=>v<a?a:(v>b?b:v);
const lerp=(a,b,t)=>a+(b-a)*t;
const smoothstep=(e0,e1,x)=>{const t=clamp((x-e0)/(e1-e0),0,1);return t*t*(3-2*t);};
const rand=(a,b)=>a+Math.random()*(b-a);
const pick=a=>a[(Math.random()*a.length)|0];
const deepClone=o=>JSON.parse(JSON.stringify(o));
function getVal(p,o){return p.split('.').reduce((a,k)=>a[k],o);}
function setVal(p,v,o){const ks=p.split('.');const l=ks.pop();ks.reduce((a,k)=>a[k],o)[l]=v;}

/* 变形系数 —— JS 与 GLSL 共用同一组数值（保证线框与画面完全一致） */
const K = {
  YAW:0.075, PITCH:0.055, XYAW:0.13,           // 头部：平移 / 俯仰 / 压扁
  BREATH_Y:0.016, BREATH_T:0.005,              // 呼吸
  HAIR_X:0.045, HAIR_Y:0.008,                  // 头发甩动
  MOUTH_Y:0.95, MOUTH_X:0.25,                  // 口型
  SQ_Y:0.35, SQ_X:0.22,                        // 受击挤压
  Z_IN:0.86, Z_OUT:1.06,                       // 头部锐利遮罩（接近刚性）
  ZS_IN:0.55, ZS_OUT:1.05                      // 其余部位柔和遮罩
};

/* =======================================================================
 * 1. 配置
 * ======================================================================= */
const DEFAULTS = {
  crop :{x0:0.00,x1:1.00,y0:0.000,y1:0.420},
  key  :{on:true,mode:'dark',tol:26,feather:1},
  head :{x:0.465,y:0.200,rx:0.155,ry:0.165},
  eyes :{x:0.465,y:0.213,dx:0.050,w:0.036,h:0.026},
  mouth:{x:0.462,y:0.276,w:0.045,h:0.028},
  breath:{x:0.480,y:0.560,rx:0.34,ry:0.34},
  hair :{x:0.470,y:0.085,rx:0.22,ry:0.15},
  amp  :{head:1.35,breath:1.60,eye:1.00,mouth:1.15},   // ★ 变形强度（新）
  follow:{headX:1.10,headY:0.75},
  overlay:{master:true,blush:true,mouth:true,eyes:true,particles:true,wire:false,
           skinAuto:true,skin:'#f2d3b8',lash:'#3b2f2c',mouthColor:'#6b2d2d',
           lidStyle:'auto'},                            // auto|skin|line|off  ★新
  audio:{master:0.85,sfx:0.95,voice:1.0,lip:true},
  view :{fit:'smart',zoom:1,ox:0,oy:0}
};
const LINE_KEYS=['idle','pokeHead','pokeBody','pat','tsukkomi','greet','confused','shy','angry'];
const LINES_DEFAULT={
  idle:['……嗯，接下来该怎么办呢。','别一直盯着我看啊。','这身衣服？还行吧。','有点无聊啊。','要不要出去走走？'],
  pokeHead:['喂！别随便碰我的头！','唔……干什么啊。','头发会乱的！','你、你想干嘛？'],
  pokeBody:['喂喂，很痒的。','别戳了别戳了。','……你有什么事吗？'],
  pat:['唔……好吧，就一小会儿。','这样啊……也没什么不好。','嗯……还挺舒服的。'],
  tsukkomi:['等一下！这明显不对劲吧！','喂喂喂，你倒是说句话啊！','别用那种眼神看着我！'],
  greet:['你好，我是菜月昴。','哦，来了啊。','初次见面……大概吧。'],
  confused:['……？','什么意思？','你在说什么？'],
  shy:['别看……很丢人的。','喂、喂！别闹了！'],
  angry:['你到底想干嘛？','够了啊！']
};
const LS_KEY='subaru-live2d-v2';
const cfg=deepClone(DEFAULTS), lines=deepClone(LINES_DEFAULT), slots={};
const S={img:null,ready:false,view:{},texW:1,texH:1,uvPad:[0,0],aspect:1,
         skinCol:[242,211,184],bbox:null,playing:null,glInfo:''};
function mergeDeep(d,s){for(const k in s){if(s[k]&&typeof s[k]==='object'&&!Array.isArray(s[k])&&d[k])mergeDeep(d[k],s[k]);else d[k]=s[k];}}
function loadCfg(){try{const r=localStorage.getItem(LS_KEY);if(!r)return;const d=JSON.parse(r);
  if(d.cfg)mergeDeep(cfg,d.cfg);if(d.lines)mergeDeep(lines,d.lines);}catch(e){}}
function saveCfg(){try{localStorage.setItem(LS_KEY,JSON.stringify({cfg,lines}));}catch(e){}}

/* =======================================================================
 * 2. 音频
 * ======================================================================= */
const A={
  ctx:null,master:null,sfx:null,voice:null,analyser:null,aData:null,buffers:{},noise:null,lipVal:0,
  init(){
    if(this.ctx)return;const C=window.AudioContext||window.webkitAudioContext;if(!C)return;
    this.ctx=new C();
    this.master=this.ctx.createGain();this.master.gain.value=cfg.audio.master;this.master.connect(this.ctx.destination);
    this.sfx=this.ctx.createGain();this.sfx.gain.value=cfg.audio.sfx;this.sfx.connect(this.master);
    this.voice=this.ctx.createGain();this.voice.gain.value=cfg.audio.voice;this.voice.connect(this.master);
    this.analyser=this.ctx.createAnalyser();this.analyser.fftSize=512;this.analyser.smoothingTimeConstant=.6;
    this.aData=new Uint8Array(this.analyser.fftSize);this.analyser.connect(this.voice);
    const n=this.ctx.createBuffer(1,this.ctx.sampleRate,this.ctx.sampleRate),d=n.getChannelData(0);
    for(let i=0;i<d.length;i++)d[i]=Math.random()*2-1;this.noise=n;
  },
  resume(){if(this.ctx&&this.ctx.state==='suspended')this.ctx.resume();},
  applyVol(){if(!this.ctx)return;this.master.gain.value=cfg.audio.master;this.sfx.gain.value=cfg.audio.sfx;this.voice.gain.value=cfg.audio.voice;},
  tone(o){if(!this.ctx)return;const t=this.ctx.currentTime,os=this.ctx.createOscillator(),g=this.ctx.createGain();
    os.type=o.type||'sine';os.frequency.setValueAtTime(o.f0,t);
    if(o.f1)os.frequency.exponentialRampToValueAtTime(Math.max(20,o.f1),t+o.dur);
    g.gain.setValueAtTime(0.0001,t);g.gain.exponentialRampToValueAtTime(o.gain||0.2,t+(o.atk||0.006));
    g.gain.exponentialRampToValueAtTime(0.0001,t+o.dur);os.connect(g);g.connect(o.dest||this.sfx);
    os.start(t);os.stop(t+o.dur+0.03);},
  noiseHit(o){if(!this.ctx)return;const t=this.ctx.currentTime,src=this.ctx.createBufferSource();
    src.buffer=this.noise;src.loop=true;const bp=this.ctx.createBiquadFilter();bp.type=o.type||'lowpass';
    bp.frequency.setValueAtTime(o.f0||900,t);if(o.f1)bp.frequency.exponentialRampToValueAtTime(Math.max(60,o.f1),t+o.dur);
    bp.Q.value=o.q||1;const g=this.ctx.createGain();g.gain.setValueAtTime(o.gain||0.25,t);
    g.gain.exponentialRampToValueAtTime(0.0001,t+o.dur);src.connect(bp);bp.connect(g);g.connect(this.sfx);
    src.start(t);src.stop(t+o.dur+0.03);},
  synth(n){switch(n){
    case 'click':this.tone({type:'square',f0:880,f1:1360,dur:0.07,gain:0.09});break;
    case 'pop':this.tone({type:'sine',f0:320,f1:980,dur:0.13,gain:0.22});break;
    case 'poke':this.noiseHit({dur:0.10,gain:0.22,f0:1600,f1:220,q:.7});this.tone({type:'sine',f0:200,f1:80,dur:0.14,gain:0.28});break;
    case 'pat':this.tone({type:'sine',f0:520,f1:640,dur:0.10,gain:0.16,atk:0.01});
              setTimeout(()=>this.tone({type:'sine',f0:660,f1:780,dur:0.10,gain:0.13,atk:0.01}),120);break;
    case 'happy':this.tone({type:'triangle',f0:784,dur:0.13,gain:0.16});
                setTimeout(()=>this.tone({type:'triangle',f0:1175,dur:0.20,gain:0.14}),110);break;
    case 'angry':this.tone({type:'sawtooth',f0:150,f1:105,dur:0.30,gain:0.16});
                this.noiseHit({dur:0.22,gain:0.12,f0:400,f1:150,q:2});break;
    case 'whoosh':this.noiseHit({type:'bandpass',dur:0.30,gain:0.18,f0:300,f1:2400,q:2.4});break;
    case 'shy':this.tone({type:'sine',f0:600,f1:900,dur:0.18,gain:0.13});
              setTimeout(()=>this.tone({type:'sine',f0:900,f1:1180,dur:0.22,gain:0.10}),140);break;
    case 'bang':this.noiseHit({dur:0.09,gain:0.30,f0:2600,f1:200,q:.6});this.tone({type:'square',f0:140,f1:60,dur:0.16,gain:0.22});break;
    default:this.tone({type:'sine',f0:660,dur:0.07,gain:0.11});}},
  play(n){
    this.init();this.resume();if(!this.ctx)return false;
    if(this.buffers[n]){
      try{const s=this.ctx.createBufferSource();s.buffer=this.buffers[n];s.connect(this.analyser);
        s.onended=()=>{S.playing=null;};s.start();S.playing=s;return true;}catch(e){}
    }
    this.synth(n);return false;
  },
  lip(dt){
    if(!this.ctx||!this.analyser){this.lipVal=lerp(this.lipVal,0,1-Math.exp(-8*dt));return this.lipVal;}
    let v=0;
    if(S.playing){this.analyser.getByteTimeDomainData(this.aData);let s=0;
      for(let i=0;i<this.aData.length;i++){const x=(this.aData[i]-128)/128;s+=x*x;}
      v=clamp(Math.sqrt(s/this.aData.length)*4.4,0,1);}
    this.lipVal=lerp(this.lipVal,v,1-Math.exp(-(v>this.lipVal?22:9)*dt));
    return this.lipVal;
  }
};

/* =======================================================================
 * 3. 图片预处理：裁剪 → 抠底 → 羽化 → 预乘 → α包围盒
 * ======================================================================= */
let texCanvas=null;
function computeCropRect(){
  const i=S.img,c=cfg.crop;
  const x0=clamp(Math.min(c.x0,c.x1),0,1),x1=clamp(Math.max(c.x0,c.x1),0.02,1);
  const y0=clamp(Math.min(c.y0,c.y1),0,1),y1=clamp(Math.max(c.y0,c.y1),0.02,1);
  return{sx:Math.round(x0*i.width),sy:Math.round(y0*i.height),
